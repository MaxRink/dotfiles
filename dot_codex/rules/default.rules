prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["env", "GOCACHE=/tmp/tcaas-cli-go-cache", "go", "test"], decision="allow")
prefix_rule(pattern=["glab", "mr", "create"], decision="allow")
prefix_rule(pattern=["glab", "mr", "checks"], decision="allow")
prefix_rule(pattern=["glab", "pipeline", "list"], decision="allow")
prefix_rule(pattern=["glab", "ci", "list"], decision="allow")
prefix_rule(pattern=["glab", "ci", "lint"], decision="allow")
prefix_rule(pattern=["glab", "mr", "view"], decision="allow")
prefix_rule(pattern=["glab", "mr", "approvers"], decision="allow")
prefix_rule(pattern=["glab", "ci", "status"], decision="allow")
prefix_rule(pattern=["glab", "auth", "status"], decision="allow")
