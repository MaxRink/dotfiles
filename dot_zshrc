  ssh-add-key () {
    key_file="$(mktemp)"
    echo "${1}" > ${key_file}
    chmod 600 ${key_file}
    ssh-add ${key_file}
    rm -rf ${key_file}
    echo "Key added successfully!\n"
}

ssh-add-bw-keys () {
    echo "Adding keys from bitwarden..."
    bw_status=$(bw status | jq -r '.status')
    if [[ ${bw_status} != 'unlocked' ]]; then
        echo "Bitwarden Vault: ${bw_status}"
        echo "Please login:"
        bw
    fi
    bw sync &> /dev/null
    # while read seems to kill \n, so we need to use a different approach
    echo "Fetching SSH keys from Bitwarden..."
    bw list items | jq -c '.[] | select(.type==5 )' | while read -r key; do
        local ssh_key=$(jq -r '.sshKey.privateKey' <<< "${key}")
        local ssh_pubkey=$(jq -r '.sshKey.publicKey' <<< "${key}")
        echo "Adding key: ${ssh_pubkey}\n"
        ssh-add-key "${ssh_key}" &> /dev/null
    done
    echo -e '\e[1A\e[KSuccessfull!'

}
