####################################################################
# Powerlevel10k
source ~/.powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
####################################################################

####################################################################
# auto completion settings (cached)
# kubectl: handled by OMZ kubectl plugin (background regen to $ZSH_CACHE_DIR/completions/_kubectl)
# flux: handled by OMZ fluxcd plugin (background regen to $ZSH_CACHE_DIR/completions/_flux)

_zsh_comp_cache_dir="$HOME/.cache/zsh/completions"
[[ -d "$_zsh_comp_cache_dir" ]] || mkdir -p "$_zsh_comp_cache_dir"

_cache_completion() {
  local cmd=$1; shift
  local cache_file="$_zsh_comp_cache_dir/_${cmd}"
  local bin_path="${commands[$cmd]}"
  if [[ -n "$bin_path" && ( ! -f "$cache_file" || "$bin_path" -nt "$cache_file" ) ]]; then
    "$bin_path" "$@" >! "$cache_file" 2>/dev/null
  fi
  [[ -f "$cache_file" ]] && source "$cache_file"
}

(( $+commands[schiff]     )) && _cache_completion schiff     completion zsh
(( $+commands[clusterctl] )) && _cache_completion clusterctl completion zsh
(( $+commands[kustomize]  )) && _cache_completion kustomize  completion zsh

# bw - disabled
# (( $+commands[bw] )) && _cache_completion bw completion --shell zsh
# yq - disabled
# (( $+commands[yq] )) && _cache_completion yq shell-completion zsh

unfunction _cache_completion
unset _zsh_comp_cache_dir
