# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"
# example for zsh. similar for bash or other supported shells.
####################################################################
# alias settings
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'
alias grep='grep --color=auto'
alias l='ls -CF'
alias la='ls -A'
alias ll='ls -alFtr'
alias ls='ls --color=auto'
alias k='kubectl'
####################################################################

####################################################################
# atuin tool
. "$HOME/.atuin/bin/env"
_atuin_bin="$HOME/.atuin/bin/atuin"
_atuin_cache="$HOME/.cache/zsh/atuin-init.zsh"
if [[ -f "$_atuin_bin" && ( ! -f "$_atuin_cache" || "$_atuin_bin" -nt "$_atuin_cache" ) ]]; then
  mkdir -p "$HOME/.cache/zsh"
  "$_atuin_bin" init zsh --disable-up-arrow >! "$_atuin_cache"
fi
[[ -f "$_atuin_cache" ]] && source "$_atuin_cache"
unset _atuin_bin _atuin_cache
