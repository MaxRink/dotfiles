{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rnvs-ai.com/schemas/diagram-quality-report.json",
  "title": "Diagram Quality Report",
  "description": "Schema for Phase2 PlantUML diagram validation reports. Defines the structure of diagram-quality-report.json generated by the diagram-validator skill.",
  "type": "object",
  "required": [
    "feature",
    "phase",
    "timestamp",
    "python_version",
    "plantuml_cli_available",
    "diagrams",
    "overall_status",
    "overall_quality_score",
    "recommendations"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "description": "Feature name being analyzed (e.g., 'NBM', 'PDA', 'RNB')",
      "examples": ["NBM", "PDA", "RNB", "PRT"]
    },
    "phase": {
      "type": "integer",
      "description": "RNVS workflow phase number (always 2 for diagram validation)",
      "const": 2
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when validation was performed",
      "examples": ["2025-11-05T12:00:00Z"]
    },
    "python_version": {
      "type": "string",
      "description": "Python version used for validation (e.g., '3.11.5')",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["3.10.0", "3.11.5", "3.12.0"]
    },
    "plantuml_cli_available": {
      "type": "boolean",
      "description": "Whether PlantUML CLI was available for Tier 2 validation"
    },
    "diagrams": {
      "type": "object",
      "description": "Validation results for each diagram",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "$ref": "#/definitions/DiagramResult"
        }
      },
      "minProperties": 1
    },
    "overall_status": {
      "type": "string",
      "enum": ["COMPLETE", "INCOMPLETE"],
      "description": "Overall validation status. COMPLETE if all gates passed and quality ≥ 70, INCOMPLETE otherwise"
    },
    "overall_quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Average quality score across all diagrams (0-100). Threshold: ≥85 production-ready, 70-84 acceptable, <70 not ready"
    },
    "recommendations": {
      "type": "array",
      "description": "List of recommendations based on validation results",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "definitions": {
    "DiagramResult": {
      "type": "object",
      "required": [
        "file",
        "validation_gates",
        "quality_score"
      ],
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to the validated .puml diagram file"
        },
        "validation_gates": {
          "type": "object",
          "description": "Results for each validation gate",
          "properties": {
            "gate_1_component_coverage": {
              "$ref": "#/definitions/Gate1Result"
            },
            "gate_2_dependency_completeness": {
              "$ref": "#/definitions/Gate2Result"
            },
            "gate_3_syntax_validation": {
              "$ref": "#/definitions/Gate3Result"
            },
            "gate_4_metadata_completeness": {
              "$ref": "#/definitions/Gate4Result"
            },
            "gate_5_renderability": {
              "$ref": "#/definitions/Gate5Result"
            }
          }
        },
        "quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Weighted quality score for this diagram (0-100)"
        }
      }
    },
    "GateStatus": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "WARNING"],
      "description": "Validation gate status"
    },
    "Gate1Result": {
      "type": "object",
      "required": [
        "status",
        "components_in_phase1",
        "components_in_diagram",
        "coverage_percentage",
        "missing_components",
        "errors",
        "warnings"
      ],
      "properties": {
        "status": {
          "$ref": "#/definitions/GateStatus"
        },
        "components_in_phase1": {
          "type": "integer",
          "minimum": 0,
          "description": "Total components discovered in Phase1 analysis.json"
        },
        "components_in_diagram": {
          "type": "integer",
          "minimum": 0,
          "description": "Components from Phase1 that appear in diagram"
        },
        "coverage_percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Component coverage percentage. Threshold: ≥80% to pass"
        },
        "missing_components": {
          "type": "array",
          "description": "List of Phase1 components missing from diagram",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Gate2Result": {
      "type": "object",
      "required": [
        "status",
        "dependencies_in_phase1",
        "dependencies_in_diagram",
        "completeness_percentage",
        "missing_dependencies",
        "errors",
        "warnings"
      ],
      "properties": {
        "status": {
          "$ref": "#/definitions/GateStatus"
        },
        "dependencies_in_phase1": {
          "type": "integer",
          "minimum": 0,
          "description": "Total dependencies in Phase1 dependency-graph.json"
        },
        "dependencies_in_diagram": {
          "type": "integer",
          "minimum": 0,
          "description": "Dependencies from Phase1 visualized in diagram"
        },
        "completeness_percentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Dependency completeness percentage. Threshold: ≥80% to pass"
        },
        "missing_dependencies": {
          "type": "array",
          "description": "List of Phase1 dependencies missing from diagram (limited to first 10)",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Gate3Result": {
      "type": "object",
      "required": [
        "status",
        "tier1_regex",
        "tier2_plantuml_cli",
        "validation_method",
        "syntax_errors",
        "errors",
        "warnings"
      ],
      "properties": {
        "status": {
          "$ref": "#/definitions/GateStatus"
        },
        "tier1_regex": {
          "type": "boolean",
          "description": "Whether Tier 1 regex validation passed (~90% accuracy)"
        },
        "tier2_plantuml_cli": {
          "type": "boolean",
          "description": "Whether Tier 2 PlantUML CLI validation passed (100% accuracy, optional)"
        },
        "validation_method": {
          "type": "string",
          "description": "Validation method used",
          "examples": [
            "Tier 1 + Tier 2",
            "Tier 1 (PlantUML CLI not available)"
          ]
        },
        "syntax_errors": {
          "type": "array",
          "description": "List of syntax errors detected",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Gate4Result": {
      "type": "object",
      "required": [
        "status",
        "legend_present",
        "notes_present",
        "labels_descriptive",
        "layout_pragmas",
        "errors",
        "warnings"
      ],
      "properties": {
        "status": {
          "$ref": "#/definitions/GateStatus"
        },
        "legend_present": {
          "type": "boolean",
          "description": "Whether legend block is present in diagram"
        },
        "notes_present": {
          "type": "boolean",
          "description": "Whether notes are present for context/external systems"
        },
        "labels_descriptive": {
          "type": "boolean",
          "description": "Whether component labels are descriptive (not generic like 'Component1', 'Service2')"
        },
        "layout_pragmas": {
          "type": "boolean",
          "description": "Whether layout pragmas are applied (e.g., '!pragma layout smetana')"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Gate5Result": {
      "type": "object",
      "required": [
        "status",
        "syntax_complete",
        "component_count",
        "complexity_warning",
        "renders_successfully",
        "errors",
        "warnings"
      ],
      "properties": {
        "status": {
          "$ref": "#/definitions/GateStatus"
        },
        "syntax_complete": {
          "type": "boolean",
          "description": "Whether all blocks are properly closed (matching braces)"
        },
        "component_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of unique components in diagram"
        },
        "complexity_warning": {
          "type": "boolean",
          "description": "Whether diagram complexity is high (>15 components)"
        },
        "renders_successfully": {
          "type": "boolean",
          "description": "Whether diagram can render (tested with PlantUML CLI if available)"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
