{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RNVS Phase 1 Dependency Graph",
  "description": "Schema for dependency-graph.json - documents dependency relationships between discovered files",
  "type": "object",
  "required": [
    "feature",
    "timestamp",
    "nodes",
    "edges",
    "dependency_closure"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "description": "Feature name (matches feature-definition.json)",
      "minLength": 3,
      "maxLength": 10
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of graph generation",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "description": "Files in the dependency graph",
      "items": {
        "type": "object",
        "required": ["id", "type", "relevance", "is_entry_point"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier (typically filename or component name)"
          },
          "type": {
            "type": "string",
            "description": "Type of component",
            "examples": ["PL/SQL Package Body", "C++ Manager Class", "TCL Script"]
          },
          "relevance": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Relevance classification from file-inventory"
          },
          "is_entry_point": {
            "type": "boolean",
            "description": "Whether this component can be invoked externally (vs internal dependency only)"
          },
          "file_path": {
            "type": "string",
            "description": "Optional full file path"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "Dependency relationships between nodes",
      "items": {
        "type": "object",
        "required": ["from", "to", "relationship"],
        "properties": {
          "from": {
            "type": "string",
            "description": "Source node ID (dependent)"
          },
          "to": {
            "type": "string",
            "description": "Target node ID (dependency)"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "calls_procedure",
              "calls_function",
              "includes_header",
              "imports_class",
              "executes_script",
              "sources_file",
              "inherits_from",
              "uses_package"
            ],
            "description": "Type of dependency relationship"
          },
          "details": {
            "type": "string",
            "description": "Human-readable description of the dependency",
            "examples": [
              "Calls p_tnb.get_operator() for TNB validation",
              "#include dependency for operator management"
            ]
          },
          "source_location": {
            "type": "string",
            "description": "Optional file:line where dependency is referenced"
          }
        }
      }
    },
    "external_dependencies": {
      "type": "array",
      "description": "Dependencies on external systems (not in RNVS codebase)",
      "items": {
        "type": "object",
        "required": ["name", "type", "referenced_by"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of external system"
          },
          "type": {
            "type": "string",
            "enum": ["External System", "Third-Party Library", "Database", "API"],
            "description": "Type of external dependency"
          },
          "referenced_by": {
            "type": "array",
            "description": "RNVS components that depend on this external system",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "integration_type": {
            "type": "string",
            "description": "How integration is performed",
            "examples": ["KCODE message exchange", "Database connection", "REST API calls"]
          }
        }
      }
    },
    "dependency_closure": {
      "type": "object",
      "description": "Validation that all internal dependencies are resolved",
      "required": [
        "is_complete",
        "unresolved_internal_count",
        "coverage_percentage"
      ],
      "properties": {
        "is_complete": {
          "type": "boolean",
          "description": "True if all internal dependencies resolved (coverage >= 95%)"
        },
        "unresolved_internal_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of unresolved internal dependencies"
        },
        "coverage_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of dependencies resolved (target >= 95%)"
        },
        "validation_message": {
          "type": "string",
          "description": "Human-readable validation status"
        }
      }
    }
  }
}
