{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migration Plan ADR",
  "description": "Schema for plan.adr.json produced by the plan-migration-adr workflow.",
  "type": "object",
  "required": [
    "schema_version",
    "feature_name",
    "title",
    "status",
    "date",
    "knowledge_level",
    "migration_type",
    "source_documents",
    "context",
    "decision",
    "migration_goal",
    "source_stack",
    "target_stack",
    "scope",
    "dependencies",
    "constraints",
    "risks",
    "success_criteria",
    "focus_areas",
    "modules",
    "consequences",
    "approvals"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "feature_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "approved", "deprecated"]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "knowledge_level": {
      "type": "string",
      "enum": ["expert", "feature-owner", "discovery"]
    },
    "migration_type": {
      "type": "string"
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "used_for"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "summary": { "type": "string" },
          "used_for": { "type": "string" }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["summary", "drivers", "current_state", "cross_cutting_findings"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "drivers": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "current_state": { "type": "string" },
        "cross_cutting_findings": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["summary", "selected_option", "rationale", "rejected_options"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "selected_option": { "type": "string" },
        "rationale": { "type": "string" },
        "rejected_options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["option", "reason"],
            "additionalProperties": false,
            "properties": {
              "option": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "migration_goal": {
      "type": "object",
      "required": ["goal", "description"],
      "additionalProperties": false,
      "properties": {
        "goal": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "source_stack": {
      "$ref": "#/$defs/stack"
    },
    "target_stack": {
      "$ref": "#/$defs/stack"
    },
    "scope": {
      "type": "object",
      "required": ["mode", "include", "exclude", "critical_components", "boundaries"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["targeted", "full", "incremental"]
        },
        "include": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "critical_components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "boundaries": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["internal", "external"],
      "additionalProperties": false,
      "properties": {
        "internal": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "external": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["unchanged", "integration"],
      "additionalProperties": false,
      "properties": {
        "unchanged": {
          "type": "array",
          "items": { "type": "string" }
        },
        "integration": {
          "type": "object",
          "required": ["systems"],
          "additionalProperties": false,
          "properties": {
            "systems": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity", "mitigation"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "mitigation": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "focus_areas": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source", "role"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["index.json", "user"]
          },
          "doc_file": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["primary", "dependency", "affected"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "consequences": {
      "type": "object",
      "required": ["positive", "negative", "follow_up_decisions"],
      "additionalProperties": false,
      "properties": {
        "positive": {
          "type": "array",
          "items": { "type": "string" }
        },
        "negative": {
          "type": "array",
          "items": { "type": "string" }
        },
        "follow_up_decisions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "approvals": {
      "type": "object",
      "required": ["approved_by", "approved_at", "review_iterations"],
      "additionalProperties": false,
      "properties": {
        "approved_by": { "type": "string" },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "stack": {
      "type": "object",
      "required": ["languages", "frameworks"],
      "additionalProperties": true,
      "properties": {
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frameworks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "infrastructure": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
