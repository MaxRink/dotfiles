{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architect Skill Output Schema",
  "description": "JSON Schema for architect session state (.architect-session.json) and saved session log (session.json)",
  "definitions": {
    "question_response": {
      "type": "object",
      "required": ["question_id", "category", "question", "answer", "answered_at"],
      "properties": {
        "question_id": {
          "type": "string",
          "description": "Unique question identifier (Q1, Q2, AQ1, DQ1, etc.)"
        },
        "category": {
          "type": "string",
          "enum": [
            "existing-patterns",
            "service-architecture",
            "data-architecture",
            "security-cross-cutting",
            "deployment-operations",
            "adaptive",
            "diagrams",
            "review"
          ],
          "description": "Question category"
        },
        "question": {
          "type": "string",
          "description": "The question text as presented to the user"
        },
        "options_presented": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Options shown to the user (empty for free text)"
        },
        "answer": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ],
          "description": "User's answer — string for single select/free text, array for multi-select"
        },
        "answered_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the user answered"
        },
        "was_skipped": {
          "type": "boolean",
          "default": false,
          "description": "True if the question was skipped due to skip_condition"
        },
        "skip_reason": {
          "type": "string",
          "description": "Reason the question was skipped (if was_skipped=true)"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["number", "decision", "chosen", "rationale"],
      "properties": {
        "number": {
          "type": "integer",
          "description": "Sequential decision number"
        },
        "decision": {
          "type": "string",
          "description": "What was decided"
        },
        "options_considered": {
          "type": "array",
          "items": { "type": "string" },
          "description": "All options that were considered"
        },
        "chosen": {
          "type": "string",
          "description": "The selected option"
        },
        "rationale": {
          "type": "string",
          "description": "Why this option was chosen"
        },
        "source_question": {
          "type": "string",
          "description": "Question ID that produced this decision (Q1, Q2, etc.)"
        }
      }
    },
    "artifact_file": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["architecture", "session", "diagram"],
          "description": "Artifact type"
        },
        "path": {
          "type": "string",
          "description": "Relative path from the architect directory"
        },
        "description": {
          "type": "string",
          "description": "Brief description of the artifact"
        }
      }
    }
  },
  "type": "object",
  "required": ["feature", "status", "started_at", "context_loaded", "responses"],
  "properties": {
    "feature": {
      "type": "string",
      "description": "Feature name being architected"
    },
    "status": {
      "type": "string",
      "enum": ["in-progress", "questions-complete", "document-generated", "review", "approved", "saved"],
      "description": "Current session status"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Session start time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Session completion time (null if in-progress)"
    },
    "context_loaded": {
      "type": "object",
      "required": ["plan", "analysis"],
      "properties": {
        "plan": {
          "type": "object",
          "required": ["loaded", "path"],
          "properties": {
            "loaded": { "type": "boolean" },
            "path": { "type": "string" },
            "migration_goals": { "type": "object" },
            "scope": { "type": "object" },
            "focus_areas": { "type": "array", "items": { "type": "string" } },
            "constraints": { "type": "object" }
          }
        },
        "analysis": {
          "type": "object",
          "required": ["loaded", "path"],
          "properties": {
            "loaded": { "type": "boolean" },
            "path": { "type": "string" },
            "business_rules_count": { "type": "integer" },
            "control_flows_count": { "type": "integer" },
            "entities_count": { "type": "integer" }
          }
        },
        "explore": {
          "type": "object",
          "properties": {
            "loaded": { "type": "boolean" },
            "path": { "type": "string" }
          }
        },
        "document": {
          "type": "object",
          "properties": {
            "loaded": { "type": "boolean" },
            "path": { "type": "string" }
          }
        }
      }
    },
    "responses": {
      "type": "array",
      "items": { "$ref": "#/definitions/question_response" },
      "description": "All question-response pairs from the session"
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/definitions/decision" },
      "description": "Architectural decisions derived from responses"
    },
    "architectural_style": {
      "type": "string",
      "description": "Chosen architectural style (from Q2)"
    },
    "diagrams_requested": {
      "type": "boolean",
      "description": "Whether the user requested target-state diagrams"
    },
    "diagram_types_requested": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Which diagram types were requested"
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "directory": {
          "type": "string",
          "description": "Output directory path"
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifact_file" }
        },
        "decisions_count": {
          "type": "integer"
        },
        "architectural_style": {
          "type": "string"
        }
      }
    },
    "review_iterations": {
      "type": "integer",
      "default": 0,
      "description": "Number of review cycles before approval"
    }
  }
}
